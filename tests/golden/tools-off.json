    "description": "Print the page into the session's files, kept past the browser.\n\nformat=\"pdf\" is the browser's own print: selectable text, the whole\ndocument. landscape turns the page and background keeps colours and images\na print drops. format=\"html\" is the page as it stands now, after its\nscripts ran.\n\nTo give it to a person, give them the file's url: it opens in any browser\nwithout a token. A server with no public address configured returns it\nrelative instead.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "background": {
          "default": false,
          "type": "boolean"
        },
        "filename": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "format": {
          "default": "pdf",
          "enum": [
            "pdf",
            "html"
          ],
          "type": "string"
        },
        "landscape": {
          "default": false,
          "type": "boolean"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    },
    "name": "print"
  },
