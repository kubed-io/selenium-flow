  "run_flow": {
    "annotations": {
      "destructive_hint": true,
      "idempotent_hint": false,
      "open_world_hint": true,
      "read_only_hint": false,
      "title": "Run a saved flow"
    },
    "description": "Run a saved flow in one call: every step, in order, in the browser you already hold. Call open_session first, and open Firefox to run the same flow there.\n\nparams supplies what the flow declares; flow://flows lists them. The result has a line per step and the final page, and verbose=true adds every step's full result. It stops at the first failing step unless that step says onError: continue, and says where.\n\nA long run reports progress while it works, and stops if the call is cancelled.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "params": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verbose": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "name": "run_flow"
  },
  "save_flow": {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": true,
      "read_only_hint": false,
      "title": "Save a flow"
    },
    "description": "Save a flow, a sequence of tool calls run server-side in one call, creating or replacing it by name.\n\nsteps is a list of {tool, args}, where args are exactly that tool's arguments; a step may also carry id, note, onError (abort or continue) and return. open_session and end_browser are not steps: a flow runs in the browser you already hold.\n\nDeclare what varies between runs in parameters and write ${name} in any argument. A value nobody may see is a secret: write's args.secret, never a string. timeout (seconds, default 120) bounds the run.\n\nThe whole document is checked against the live tools, and every problem is listed at once. flow://schema has the full shape; skill://selenium-flow/references/FLOWS.md explains writing one.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parameters": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "steps": {
          "items": {},
          "type": "array"
        },
        "timeout": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "steps"
      ],
      "type": "object"
    },
    "name": "save_flow"
  },
  "save_site_data": {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": true,
      "read_only_hint": false,
      "title": "Save site data"
    },
    "description": "Save this session's site data, so a new browser comes back signed in.\n\nIt keeps every cookie the browser holds, the localStorage of the sites it has\nbeen to, and the sessionStorage of the page it is on. Call it right after a\nsign-in is confirmed, and after changing a setting you want kept; never before\nchecking you landed, or you keep a failed sign-in.\n\nOne save covers every site a call ended on, while the session keeps its\nhistory (a day by default, 100 sites): one passed through inside a call is not\nread, and one last visited longer ago loses its storage at the next save, its\ncookies staying. Each save replaces the last, so a save after signing out\nsaves you signed out. Every browser opened for this session has it back before\nopen_session returns, the one that replaces a reaped browser included. Values\nare never returned; session://site-data lists what is saved.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    },
    "name": "save_site_data"
  },
