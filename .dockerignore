# .git is deliberately NOT ignored: setuptools_scm derives the version from it,
# and the build fails without it.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.github/
*.log
# The wiki is a submodule of prose. It has no part in the build, and it only
# grows, so keeping it out of the context keeps that growth free.
wiki/
